<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-build-only override of app/src/main/res/xml/network_security_config.xml (Android's
    standard source-set resource override — this file replaces the main one only for debug
    builds; release packaging never sees it). Permits cleartext so instrumented tests
    (ContentSyncManagerTest) can talk to a local MockWebServer instance over plain HTTP; production
    CMS API traffic is always HTTPS regardless of this override.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
