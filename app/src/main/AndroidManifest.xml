<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Arah Kiblat only. Coarse is enough: the bearing varies by well under a degree across a
       city, so the app never asks for a precise fix and never starts an active location request.
       Optional — every other feature works without it (docs/security/PRIVACY.md). -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-feature
    android:name="android.hardware.location"
    android:required="false" />
  <!-- Pengingat Amaliyah (0.0.4): runtime-requested on API 33+ (data/reminder/, feature/reminder/'s
       notification permission flow); a no-op declaration below that version. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Pengingat Amaliyah (0.0.4): lets ReminderBootReceiver re-arm alarms after reboot — AlarmManager
       alarms do not otherwise survive a device restart (ROADMAP.md's "Rescheduling after reboot"). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Murottal per-ayat: recitation keeps playing after the reader is left, which requires a
       foreground media-playback service and its own typed permission on API 34+. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <!-- Adzan alarms. The rest of the app schedules inexactly on purpose (data/reminder/, the widget)
       and says why; an adzan cannot — `setAndAllowWhileIdle` may hold an alarm for several minutes
       in Doze, and an adzan minutes after the published time is a wrong one, not a late reminder.
       USE_EXACT_ALARM is auto-granted and is the API for an app whose core function is announcing
       times of day; SCHEDULE_EXACT_ALARM covers API 31-32, which predate it and grant it at
       install. See docs/decisions/0019. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission
    android:name="android.permission.SCHEDULE_EXACT_ALARM"
    android:maxSdkVersion="32" />

  <application
    android:name=".SanguSantriApplication"
    android:allowBackup="true"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:enableOnBackInvokedCallback="true"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.SanguSantri">
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:theme="@style/Theme.SanguSantri"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Murottal playback host: keeps recitation running, with the system media notification and
         lock-screen/media-button controls, after the reader is left.

         Not exported. Media3's samples export this service so external controllers (Android Auto,
         Wear, Assistant) can bind and browse a media library; SanguSantri offers no browsable media
         library and targets none of those surfaces, so exporting it would only widen the app's IPC
         surface for nothing (docs/security/SECURITY_BASELINE.md). In-app controllers, the foreground
         notification and hardware media buttons all work without it — those reach the MediaSession
         through the framework rather than by binding to this service. -->
    <service
      android:name=".data.audio.QuranMurottalService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaSessionService" />
      </intent-filter>
    </service>

    <!-- Jadwal Sholat's adzan. Not exported, no media session: it plays one to three bundled
         recordings in order and stops, and offers no browsable library for an external controller
         to reach. Separate from QuranMurottalService above by design — see the class KDoc. -->
    <service
      android:name=".data.prayeralarm.AdzanPlaybackService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

    <!-- The one prayer alarm, re-armed after every firing. System-only broadcast. -->
    <receiver
      android:name=".data.prayeralarm.PrayerAlarmReceiver"
      android:exported="false" />

    <!-- Pengingat Amaliyah (0.0.4): both system-only broadcasts, never sent by another app, so
         neither needs to be exported. -->
    <receiver
      android:name=".data.reminder.ReminderAlarmReceiver"
      android:exported="false" />
    <receiver
      android:name=".data.reminder.ReminderBootReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>

    <!-- Jadwal Sholat home-screen widget. Exported because the launcher (a different app) is what
         sends it ACTION_APPWIDGET_UPDATE — an app-widget provider that is not exported is never
         offered in the widget picker. It accepts no data from the intent beyond the framework's own
         widget ids. -->
    <receiver
      android:name=".feature.prayertimes.widget.PrayerTimesWidgetProvider"
      android:exported="true"
      android:label="@string/widget_prayer_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>

      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/prayer_times_widget_info" />
    </receiver>

    <!-- Second picker entry, the horizontal band. Same provider logic (it subclasses the one
         above and adds nothing); only the appwidget-provider XML differs. -->
    <receiver
      android:name=".feature.prayertimes.widget.PrayerTimesWideWidgetProvider"
      android:exported="true"
      android:label="@string/widget_prayer_wide_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>

      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/prayer_times_wide_widget_info" />
    </receiver>

    <!-- Third picker entry: the prayer strip plus the ayat of the day. Also a subclass, overriding
         only the layout, the quote line and where a tap goes (Beranda, not Jadwal Sholat). -->
    <receiver
      android:name=".feature.prayertimes.widget.PrayerTimesAyatWidgetProvider"
      android:exported="true"
      android:label="@string/widget_prayer_ayat_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>

      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/prayer_times_ayat_widget_info" />
    </receiver>

    <!-- Grants another app read access to exactly one cache subfolder: the ayah share card written
         by the Beranda sheet. Not exported and no permission of its own — access is only ever the
         one-shot grant that rides on the ACTION_SEND intent. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>

    <!--
         SanguSantriApplication implements Configuration.Provider (custom HiltWorkerFactory),
         so WorkManager's default androidx-startup initializer must be removed — otherwise
         WorkManager initializes itself twice with two different configurations.
    -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>
  </application>

</manifest>
