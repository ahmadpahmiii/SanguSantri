<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Arah Kiblat only. Coarse is enough: the bearing varies by well under a degree across a
       city, so the app never asks for a precise fix and never starts an active location request.
       Optional — every other feature works without it (docs/security/PRIVACY.md). -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-feature
    android:name="android.hardware.location"
    android:required="false" />
  <!-- Pengingat Amaliyah (0.0.4): runtime-requested on API 33+ (data/reminder/, feature/reminder/'s
       notification permission flow); a no-op declaration below that version. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Pengingat Amaliyah (0.0.4): lets ReminderBootReceiver re-arm alarms after reboot — AlarmManager
       alarms do not otherwise survive a device restart (ROADMAP.md's "Rescheduling after reboot"). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application
    android:name=".SanguSantriApplication"
    android:allowBackup="true"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:enableOnBackInvokedCallback="true"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.SanguSantri">
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:theme="@style/Theme.SanguSantri"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Pengingat Amaliyah (0.0.4): both system-only broadcasts, never sent by another app, so
         neither needs to be exported. -->
    <receiver
      android:name=".data.reminder.ReminderAlarmReceiver"
      android:exported="false" />
    <receiver
      android:name=".data.reminder.ReminderBootReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>

    <!--
         SanguSantriApplication implements Configuration.Provider (custom HiltWorkerFactory),
         so WorkManager's default androidx-startup initializer must be removed — otherwise
         WorkManager initializes itself twice with two different configurations.
    -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>
  </application>

</manifest>
