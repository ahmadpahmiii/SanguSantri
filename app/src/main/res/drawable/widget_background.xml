<?xml version="1.0" encoding="utf-8"?><!-- The glass panel: translucent neutral fill plus the hairline edge that keeps it from melting
     into the wallpaper. Both colours carry their own alpha (see values/widget_colors.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle">
  <solid android:color="@color/widget_glass" />
  <corners android:radius="@dimen/widget_corner_radius" />
  <stroke
    android:width="1dp"
    android:color="@color/widget_glass_border" />
</shape>
