<?xml version="1.0" encoding="utf-8"?><!-- Behind the next prayer's row/column. A small fixed radius, not the panel's and not the
     platform's 20dp inner radius: the row is only about 28dp tall, so anything near half that
     rounds the chip into an oval. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle">
  <solid android:color="@color/widget_highlight" />
  <corners android:radius="@dimen/widget_highlight_radius" />
</shape>
