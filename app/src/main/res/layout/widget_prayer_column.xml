<?xml version="1.0" encoding="utf-8"?><!-- One prayer in the wide strip: name over time.

     Inflated by PrayerTimesWidgetProvider. See widget_prayer_row.xml for why the colours are
     declared here instead of being pushed from code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_row"
  android:layout_width="0dp"
  android:layout_height="wrap_content"
  android:layout_weight="1"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:paddingVertical="@dimen/widget_column_padding_vertical">

  <TextView
    android:id="@+id/widget_row_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center_horizontal"
    android:maxLines="1"
    android:textColor="@color/widget_dim"
    android:textSize="@dimen/widget_text_column_name" />

  <TextView
    android:id="@+id/widget_row_time"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/widget_column_time_spacing"
    android:ellipsize="end"
    android:gravity="center_horizontal"
    android:maxLines="1"
    android:textColor="@color/widget_strong"
    android:textSize="@dimen/widget_text_column_time" />
</LinearLayout>
