  <!-- Al-Qur'an Kemenag source view (`0.0.6`, QUR-FR-019) -->
  <string name="quran_source_title">Sumber Al-Qur\'an</string>
  <string name="quran_source_heading">Al-Qur\'an Kemenag</string>
  <string name="quran_source_provenance_body">Teks Al-Qur\'an, terjemahan, dan tafsir pada aplikasi ini diambil langsung dari API resmi Lajnah Pentashihan Mushaf Al-Qur\'an (LPMQ), Kementerian Agama Republik Indonesia.</string>
  <string name="quran_source_fields_title">Data yang digunakan</string>
  <string name="quran_source_fields_body">Daftar surah, teks Arab, terjemahan, dan tafsir (ringkas dan tahlili) per ayat. Transliterasi Latin dari sumber tidak ditampilkan maupun disimpan oleh aplikasi ini.</string>
  <string name="quran_source_offline_title">Penyimpanan offline</string>
  <string name="quran_source_offline_body">Setelah pengambilan data awal, seluruh Al-Qur\'an disimpan secara lokal di perangkat sehingga dapat dibaca tanpa koneksi internet. Pembaruan menyeluruh dari Kemenag dapat terjadi secara berkala saat aplikasi terhubung ke internet.</string>
  <string name="quran_source_read_only_body">SanguSantri menggunakan data secara baca-saja dan tidak mengubah, menerjemahkan ulang, menggabungkan, atau mengoreksi isi dari Kemenag.</string>
  <string name="quran_source_permission_title">Izin dan jaringan</string>
  <string name="quran_source_permission_body">Aplikasi memerlukan akses internet untuk pengambilan data awal dan pembaruan berkala. Saat membuka tafsir sebuah ayat, permintaan tersebut mengirimkan identitas ayat yang dipilih ke server Kemenag beserta metadata jaringan standar (seperti alamat IP). Tidak ada bookmark, riwayat bacaan, atau data pribadi yang dikirim ke Kemenag.</string>
  <string name="quran_source_disclaimer_title">Catatan</string>
  <string name="quran_source_disclaimer_body">SanguSantri bukan aplikasi resmi terbitan Kementerian Agama. Aplikasi ini hanya menggunakan data dari API resmi Kemenag melalui akses yang telah disetujui, dan tidak mewakili maupun diterbitkan oleh Kementerian Agama. Ini tidak menyiratkan dukungan institusional terhadap fitur lain di aplikasi.</string>

